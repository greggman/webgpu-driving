{
  "name": "webgpu-driving",
  "version": "0.1.0",
  "description": "A relaxing procedural driving simulation in WebGPU",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "serve": "node test/server.js",
    "shoot": "node test/shoot.js",
    "unit": "node test/unit/build-and-run.mjs",
    "lint": "gts lint",
    "fix": "gts fix",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && npm run build && npm run unit && npm run shoot"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "gts": "^7.0.0",
    "puppeteer": "^25.12.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.12.0": true
  }
}
